# Copy to .env.local and fill in

# AI (server-side only — never prefix with NEXT_PUBLIC_)
# Which provider serves real recipes: "gemini" (free tier) or "anthropic"
AI_PROVIDER=gemini

# Google Gemini: free key from https://aistudio.google.com → "Get API key"
# Note: on the free tier Google may use prompts to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Used when the main model is overloaded (503 "high demand"); richer but often busy
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# Anthropic Claude (paid)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_VISION_MODEL=claude-sonnet-5-5

# 1 = always use fixture recipes. Set to 0 to use the provider above (needs its key).
NEXT_PUBLIC_MOCK_AI=1

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Session pooler URI, with your DB password) for `pnpm db:migrate`
# and the RLS test. Server/scripts only.
SUPABASE_DB_URL=

# Rate limiting / caching (optional: Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
